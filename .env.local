# LOCAL — the Supabase stack on this machine. For SCHEMA work.
#
# Switch with:  npm run env:local
# Requires the stack to be running:  supabase start
#
# ---------------------------------------------------------------------------
# 127.0.0.1 ONLY WORKS ON A SIMULATOR RUNNING ON THIS MAC.
# ---------------------------------------------------------------------------
# A physical phone is a different machine on the network and cannot reach this
# Mac's loopback address. For a real device, replace the host below with this
# Mac's LAN address:
#
#     ipconfig getifaddr en0          # e.g. 192.168.1.230
#     EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.230:54321
#
# That address CHANGES when you join a different network, which is precisely
# why the in-app environment badge shows the host rather than the word
# "local". If the app says it is talking to a host you do not recognise, that
# is the answer to "why is my data not there".
#
# These keys are the Supabase CLI's fixed local development keys. They are
# identical on every machine, are not secret, and grant nothing beyond a
# database that lives on your laptop.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
