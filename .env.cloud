# CLOUD — the shared Supabase project. The DEFAULT for development.
#
# Switch with:  npm run env:cloud
# Never hand-edit .env. A half-switch -- local URL with a cloud key, or the
# reverse -- fails as an opaque auth error that looks like nothing at all.
#
# Why cloud is the default for dev work: it has 39,304 places against local's
# 1,469, and UI work wants real data -- real names, real density, real mess.
# Local is for SCHEMA work, and CLAUDE.md already guarantees it gets
# exercised on every migration.
#
# Both values below are publishable by design. The publishable key is useless
# without RLS passing, and every catalog policy is `to authenticated`.
EXPO_PUBLIC_SUPABASE_URL=https://oygsbuailwpjgkqbxllp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_2ccixSdSgSIHoNjkmKeeJg_E0OFR-js
