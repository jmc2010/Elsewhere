# Client-side (safe to ship in the bundle).
# Copy this file to .env and fill these in. Both are publishable by design:
# the anon key is useless without RLS passing, and every catalog policy is
# `to authenticated`.
#
# Supabase dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side ONLY — set these as Supabase Edge Function secrets:
#
#   supabase secrets set GOOGLE_MAPS_API_KEY=...
#   supabase secrets set ANTHROPIC_API_KEY=...
#
# Never add EXPO_PUBLIC_ to these, and never reference them from app code.
# An EXPO_PUBLIC_ prefix inlines the value into the JS bundle, where anyone
# who downloads the app can read it. For the Maps key that is a direct bill;
# see docs/measurements.md for what the SKUs cost.
#
# The app never needs a Google key. It calls places-proxy instead.
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
